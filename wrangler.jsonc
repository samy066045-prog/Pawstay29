{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pawstay",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // The website (public/) is served as static assets; only /api/* runs the Worker code
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  // D1 = Cloudflare's SQLite database. Paste the id you get from: npx wrangler d1 create pawstay-db
  "d1_databases": [
    { "binding": "DB", "database_name": "pawstay-db", "database_id": "ec919a3c-d8ed-4200-8059-95869ebdd9ac" }
  ]
}
